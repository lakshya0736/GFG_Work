class Solution {
    public ArrayList<Node> findPreSuc(Node root, int key) {
        ArrayList<Node> ans = new ArrayList<>();
        Node pred = null;
        Node suc = null;
        Node curr = root;
        while(curr!=null){
            if(curr.data==key){
                if(curr.left!=null){
                   Node temp = curr.left;
                   while(temp.right!=null) temp = temp.right;
                   pred = temp;
                }
                if(curr.right!=null){
                   Node temp = curr.right;
                   while(temp.left!=null) temp = temp.left;
                   suc = temp;
                }
                break;
                
            }
            else if(curr.data<key){
                pred = curr;
                curr = curr.right;
            }
            else{
                suc = curr;
                curr = curr.left;
            }
        }
        ans.add(pred);
        ans.add(suc);
        return ans;
    }
}

