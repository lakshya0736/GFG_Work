/*
Definition for Node
class Node {
    int data;
    Node left;
    Node right;

    Node(int val) {
        data = val;
        left = right = null;
    }
}
*/

class Solution {
    public boolean search(Node root, int target) {
        while(root!=null){
            if(root.data>target) root = root.left;
            else if(root.data<target) root = root.right;
            else if(root.data==target) return true;
        }
        return false;
        
    }
}

