class Solution {
    public int leastWeightCapacity(ArrayList<Integer> arr, int d) {
        int n = arr.size();
        int low = 0;
        int high = 0;
        for(int i=0;i<n;i++){
            low = Math.max(low,arr.get(i));
            high += arr.get(i);
        }
        int ans = 0;
        while(low<=high){
            int mid = low + (high-low)/2;
            int count = 1;
            int sum=0;
            for(int i=0;i<n;i++){
                if(sum + arr.get(i) > mid){
                      count++;
                      sum = arr.get(i);
                }
                else{
                     sum += arr.get(i);
                }
            }
            if(count<=d){
                ans = mid;
                high = mid-1;
            }
            else low = mid+1;
        }
        return ans;
        
    }
}
