//Tabulation


class Solution {
    public int countFriendsPairings(int n) {
        if(n<=2) return n;
        int[] dp = new int[n+1];
        int m = dp.length;
        dp[1] = 1;
        dp[2] = 2;
        for(int i=3;i<m;i++){
            dp[i] = dp[i-1]+(i-1)*dp[i-2];
        }
        return dp[m-1];
        
    }
}

