class Solution {
    public static int longestBitonicSequence(int n, int[] arr) {
            int[] LIS = new int[n];
            Arrays.fill(LIS,1);
            for(int i=1;i<n;i++){
                int max =0;
                for(int j=0;j<i;j++){
                    if(arr[j]<arr[i]) max=Math.max(max,LIS[j]);
                }
                LIS[i] += max;
            }
            int[] LDS = new int[n];
            Arrays.fill(LDS,1);
            for(int i=n-2;i>=0;i--){
                int max =0;
                for(int j=i+1;j<n;j++){
                    if(arr[j]<arr[i]) max=Math.max(max,LDS[j]);
                }
                LDS[i] += max;
            }
            int maxlen = 0;
            for(int i=0;i<n;i++){
                if(LIS[i]!=1 && LDS[i]!=1)
                    maxlen = Math.max(maxlen,LIS[i]+LDS[i]-1);
            }
            return maxlen;
        }
}
