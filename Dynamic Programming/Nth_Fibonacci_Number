class Solution {
    
    //Tabulation
    static int nthFibonacci(int n) {
            int[] dp = new int[n+1];
            if(n>=1) dp[1] = 1;
            for(int i=2;i<=dp.length-1;i++){
                dp[i] = dp[i-1]+dp[i-2];
            }
            return dp[n];
        }
    
