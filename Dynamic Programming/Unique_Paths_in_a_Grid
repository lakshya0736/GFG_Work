class Solution {
    public int uniquePaths(int[][] arr) {
        int m = arr.length; int n = arr[0].length;
        int[][] dp = new int[m+1][n+1];
        if(arr[0][0]==1 || arr[m-1][n-1] == 1) return 0;
        dp[0][0]=1;
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(i==0&&j==0) continue;
                else if(arr[i][j]==1) dp[i][j]=0;
                else{
                    int top = 0;
                    int left = 0;
                    if(i>0) top=dp[i-1][j];
                    if(j>0) left=dp[i][j-1];
                    dp[i][j] = top+left;
                }
            }
        }
        return dp[m-1][n-1];
    }
};
