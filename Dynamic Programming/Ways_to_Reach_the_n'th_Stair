class Solution {
    static int[] dp;
    public int countWays(int n) {
        dp = new int[n+1];
        Arrays.fill(dp,-1);
        return count(n);
        
    }
    public int count(int n){
        if(n<=3) return n;
        if(dp[n]!=-1) return dp[n];
        return dp[n] = count(n-1)+count(n-2);
    }
}
