class Solution {
    boolean twoSum(int arr[], int target) {
        HashSet<Integer> set = new HashSet<>();
        int n = arr.length;
        for(int i=0;i<n;i++){
            int remaining = target - arr[i];
            if(!set.contains(remaining)) set.add(arr[i]);
            else return true;
        }
        return false;
        
    }
}
