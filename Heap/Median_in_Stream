class Solution {
    public ArrayList<Double> getMedian(int[] num) {
        ArrayList<Double>  arr = new ArrayList<>();
        PriorityQueue<Integer> minheap = new PriorityQueue<>();
        PriorityQueue<Integer> maxheap = new PriorityQueue<>(Collections.reverseOrder());
        for(int ele : num){
            if(maxheap.size()==0) maxheap.add(ele);
            else{
                if(maxheap.peek()>ele) maxheap.add(ele);
                else minheap.add(ele);
            }
            if(maxheap.size()==minheap.size()+2) minheap.add(maxheap.remove());
            if(minheap.size()==maxheap.size()+2) maxheap.add(minheap.remove());
            if(minheap.size()==maxheap.size()+1) arr.add((double)minheap.peek());
            else if(maxheap.size()==minheap.size()+1) arr.add((double)maxheap.peek());
            else arr.add((maxheap.peek()+minheap.peek())/2.0);
        }
        return arr;
    }
}
