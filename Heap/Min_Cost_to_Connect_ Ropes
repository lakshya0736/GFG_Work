class Solution {
    public int minCost(int[] arr) {
        int sum = 0;
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for(int ele:arr){
            pq.add(ele);
        }
        while(pq.size()>1){
            int first = pq.remove();
            int second = pq.remove();
            sum += first+second;
            pq.add(first+second);
        }
        return sum;
    }
}
