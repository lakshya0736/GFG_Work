class Solution {
    public Node reverse(Node head){
        Node prev = null;
        Node frwd = null;
        Node curr = head;
        while(curr!=null){
            frwd = curr.next;
            curr.next = prev;
            prev = curr;
            curr = frwd;
        }
        return prev;
    }
    public Node addTwoLists(Node head1, Node head2) {
        if(head1==null&&head2==null) return null;
        head1 = reverse(head1);
        head2 = reverse(head2);
        Node t1 = head1;
        Node t2 = head2;
        Node d = new Node(-1);
        Node t = d;
        int carry = 0;
        int sum =0;
        while(t1!=null||t2!=null){
            sum = carry;
            if(t1 != null){
                sum += t1.data;
                t1 = t1.next;
            }

            if(t2 != null){
                sum += t2.data;
                t2 = t2.next;
            }
            Node a = new Node(sum%10);
            t.next = a;
            t = t.next;
            carry = sum/10;;
        }
        if(carry != 0){
            t.next = new Node(carry);
        }
        d = reverse(d.next);
        Node temp = d;
        if(temp.next==null) return temp;
        while(temp!=null&&temp.data==0){
            temp = temp.next;
        }
        return temp;
    }
}
