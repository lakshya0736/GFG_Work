/* Structure of Linked List Node
class Node {
    int data;
    Node next;

    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    Node deleteNode(Node head, int key) {
        Node temp = head;
        while(temp.next!=head){
            temp = temp.next;
        }
        temp.next = null;
        if(head.data == key){
            head = head.next;
            temp.next = head;
            return head;
        }
        Node t1 = head;
        Node t2 = head.next;
        while(t2!=null){
            if(t2.data==key){
                t1.next = t2.next;
                if(t2==temp)  t1.next = head;
                break;
            }
            t1 = t1.next;
            t2 = t2.next;
        }
        temp.next = head;
        return head;
        
    }
}
