/* Node Structure
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
} */

class Solution {
    public int getKthFromLast(Node head, int k) {
        // code here
        int length = 0;
        Node temp = head;
        while(temp != null){
            temp = temp.next;
            length++;
        }
        if(k>length) return -1;
        temp = head;
        for(int i=0;i<length-k;i++){
            temp=temp.next;
        }
        return temp.data;
    }
}
