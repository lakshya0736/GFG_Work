class Solution {
    Node merge(Node head1,Node head2){
        Node dummy  = new Node(-1);
        Node t = dummy;
        Node t1 = head1;
        Node t2 = head2;
        while(t1!=null && t2!=null){
            if(t1.data<t2.data){
                t.next = t1;
                t=t.next;
                t1 = t1.next;
            }else{
                t.next = t2;
                t =t.next;
                t2=t2.next;
            }
        }
        if(t1==null) t.next = t2;
        else t.next = t1;
        return dummy.next;
    }
    Node mergeKLists(Node[] lists) {
        ArrayList<Node> arr = new ArrayList<>();
        for(Node n : lists) arr.add(n);
        while(arr.size()>1){
            Node a = arr.get(arr.size()-1);
            arr.remove(arr.size()-1);
            Node b = arr.get(arr.size()-1);
            arr.remove(arr.size()-1);
            Node c = merge(a,b);
            arr.add(c);
        }
        return arr.get(0);
        
    }
}
