/* Structure of a Linked List node
class Node {
    int data;
    Node next;
    Node(int key) {
        data = key;
        next = null;
    }
} */

class Solution {
    public Node mergeSort(Node head) {
        // code here
        if(head.next==null) return head;
        Node slow = head;
        Node fast = head;
        while(fast.next!=null&&fast.next.next!=null){
            slow = slow.next;
            fast = fast.next.next;
        }
        Node head2 = slow.next;
        slow.next = null;
        head=mergeSort(head);
        head2=mergeSort(head2);
        return sortedMerge(head,head2);
    }
    static Node sortedMerge(Node head1, Node head2) {
        Node dummy = new Node(-1);
        Node k = dummy;
        Node i = head1;
        Node j = head2;
        while(i!=null&&j!=null){
            if(i.data<j.data){
                k.next = i;
                k=k.next;
                i=i.next;
            }else{
                k.next = j;
                k=k.next;
                j=j.next;
            }
        }
        if(i==null) k.next=j;
        if(j==null) k.next=i;
        return dummy.next;
    }
}
