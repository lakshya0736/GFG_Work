class Solution {
    Node sortedMerge(Node head1, Node head2) {
        Node dummy = new Node(-1);
        Node k = dummy;
        Node i = head1;
        Node j = head2;
        while(i!=null&&j!=null){
            if(i.data<j.data){
                k.next = i;
                k=k.next;
                i=i.next;
            }else{
                k.next = j;
                k=k.next;
                j=j.next;
            }
        }
        if(i==null) k.next=j;
        if(j==null) k.next=i;
        return dummy.next;
        
    }
}
