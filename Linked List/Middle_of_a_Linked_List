class Solution {
    int getMiddle(Node head) {
        if(head==null) return -1;
        int length = 0;
        Node temp = head;
        while(temp!=null){
            temp = temp.next;
            length++;
            
        }
        Node t = head;
        for(int i=0;i<length/2;i++){
                t=t.next;
        }
        return t.data;
        
    }
}
