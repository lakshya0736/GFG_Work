/* Structure of Doubly Linked List Node
class Node {
    int data;
    Node next;
    Node prev;

    Node(int data) {
        this.data = data;
        this.next = null;
        this.prev = null;
    }
}
*/
class Solution {
    public Node reverse(Node head) {
        Node prev = null;
        Node frwd = null;
        Node curr = head;
        while(curr!=null){
            frwd = curr.next;
            curr.next = prev;
            curr.prev = frwd;
            prev = curr;
            curr = frwd;
        }
        return prev;
        
    }
}
