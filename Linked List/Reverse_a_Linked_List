class Solution {
    Node reverseList(Node head) {
        Node prev = null;
        Node frwd=null;
        Node curr = head;
        while(curr!=null){
            frwd = curr.next;
            curr.next = prev;
            prev = curr;
            curr = frwd;
        }
        return prev;
    }
}
