/* Structure of a doubly link list node
class Node {
    int data;
    Node prev, next;
    Node(int x) {
        data = x;
        prev = null;
        next = null;
    }
}*/

class Solution {
    public Node rotateDLL(Node head, int k) {
        if(head==null||head.next==null) return head;
        Node slow = head;
        for(int i=1;i<k;i++){
            slow = slow.next;
        }
        if(slow.next==null) return head;
        Node a = slow.next;
        slow.next = null;
        a.prev = null;
        Node t = a;
        while(t.next!=null){
            t =t.next;
        }
        t.next = head;
        head.prev = t;
        return a;
        
    }
}
